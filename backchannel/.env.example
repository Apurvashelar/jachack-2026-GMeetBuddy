# Copy to .env and fill in. .env is gitignored - never commit real keys.

# Powers by llm() answers, intent routing, and OpenAI TTS.
# Without it Backchannel falls back to deterministic keyword retrieval.
OPENAI_API_KEY=sk-...

# Optional: which model the by llm() functions use.
BC_MODEL=gpt-4o-mini

# The ACTION demo. Without these, dispatch_action returns a dry-run receipt.
# Use a PERSONAL fine-grained PAT with Issues:write on the demo repo only.
GITHUB_PAT=
GITHUB_OWNER=
GITHUB_REPO=

# Which org-agent adapter dispatch_action routes to.
ORG_AGENT_KIND=github

# Set to 1 only for the local bot-voice demo (needs BlackHole + mpv).
SPEAK_LOCAL=0
