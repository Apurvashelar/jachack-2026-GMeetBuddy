# Copy to .env and fill in. .env is gitignored - never commit real keys.

# Powers by llm() answers, intent routing, and OpenAI TTS.
# Without it Backchannel falls back to deterministic keyword retrieval.
OPENAI_API_KEY=sk-...

# Optional: which model the by llm() functions use.
BC_MODEL=gpt-4o-mini

# The ACTION demo. Without these, dispatch_action returns a dry-run receipt.
# Use a PERSONAL fine-grained PAT with Issues:write on the demo repo only.
GITHUB_PAT=
GITHUB_OWNER=
GITHUB_REPO=

# Which org-agent adapter dispatch_action routes to.
ORG_AGENT_KIND=github

# Set to 1 only for the local bot-voice demo (needs BlackHole + mpv).
SPEAK_LOCAL=0

# Where per-meeting workspaces live (docs drop-zone + context.md).
# Point this INSIDE a "Google Drive for desktop" folder and every meeting's
# docs and context files sync to Drive with zero API setup, e.g.:
#   BC_MEETINGS_DIR=/Users/you/Google Drive/My Drive/backchannel
#BC_MEETINGS_DIR=meetings

# Set to 0 to disable launching the Meet bot from the dashboard.
#BC_ALLOW_BOT=1

# Slack side-channel: create the app from slack_manifest.yaml, install it,
# paste the Bot User OAuth Token here. Auto-creates #bc-<meeting> per series.
#SLACK_BOT_TOKEN=xoxb-...
